<view class="page">
  <view class="hero">
    <view class="deco d1">✨</view>
    <view class="deco d2">💕</view>
    <view class="deco d3">✨</view>
    <view class="hero-title">心有灵犀</view>
    <view class="hero-sub">一人出题 · 一人作答 · 当场揭晓你们有多默契</view>
    <button class="hero-btn" bindtap="goCreate">🔮 我要出题</button>
    <view class="hero-how" bindtap="toggleHow">{{showHow ? '收起玩法' : '玩法说明'}}</view>
  </view>

  <view class="card how" wx:if="{{showHow}}">
    <view class="how-title">🎈 怎么玩</view>
    <view class="how-item">1️⃣ 出题人挑选 5 道题（题库或自定义），写下自己的答案</view>
    <view class="how-item">2️⃣ 生成挑战，发给那个「TA」</view>
    <view class="how-item">3️⃣ 对方答完，当场生成默契度战报</view>
    <view class="how-item">4️⃣ 对方把战报分享回来，逐题对照见真情</view>
    <view class="how-tip">答案藏在分享卡片里，无服务器、无注册，纯粹开心 ✨</view>
  </view>

  <view wx:if="{{recent.length}}">
    <view class="sec-title">📜 最近战报</view>
    <view class="card recent-card">
      <view class="recent-item" wx:for="{{recent}}" wx:key="t" bindtap="openRecent" data-rd="{{item.rd}}">
        <view class="recent-title">
          {{item.role === 'a' ? '你向 ' + item.peer + ' 发起了挑战' : item.peer + ' 应战了你的考题'}}
          <view class="recent-time">{{item.when}} · {{item.verdict}}</view>
        </view>
        <view class="recent-score">{{item.score}}%</view>
      </view>
    </view>
  </view>

  <view class="foot">心有灵犀一点通 · 李商隐诚不我欺</view>
</view>
