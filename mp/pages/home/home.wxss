.page { padding: 24rpx 32rpx 60rpx; }

.hero {
  margin-top: 16rpx;
  border-radius: 44rpx;
  padding: 76rpx 44rpx 64rpx;
  background: var(--grad);
  color: #fff;
  text-align: center;
  position: relative;
  overflow: hidden;
  box-shadow: 0 20rpx 60rpx rgba(179, 79, 209, 0.35);
}
.hero-title { font-size: 72rpx; letter-spacing: 10rpx; font-weight: 800; }
.hero-sub { margin-top: 18rpx; font-size: 26rpx; opacity: 0.92; }
.hero-btn {
  margin-top: 52rpx;
  background: rgba(255, 255, 255, 0.22);
  color: #fff;
  font-size: 34rpx;
  font-weight: 600;
  padding: 8rpx 0;
  width: 78%;
  border: none;
}
.hero-btn::after { border: none; }
.hero-how {
  margin-top: 24rpx;
  font-size: 24rpx;
  opacity: 0.85;
  display: inline-block;
  padding: 8rpx 28rpx;
  background: rgba(255, 255, 255, 0.18);
  border-radius: 999rpx;
}
.deco { position: absolute; font-size: 44rpx; opacity: 0.8; animation: float 3.2s ease-in-out infinite; pointer-events: none; }
.deco.d1 { right: 16%; bottom: 20%; }
.deco.d2 { font-size: 60rpx; left: 10%; top: 20%; animation-delay: 0.6s; }
.deco.d3 { right: 12%; top: 26%; animation-delay: 1.2s; }
@keyframes float {
  0%, 100% { transform: translateY(0) rotate(0); }
  50% { transform: translateY(-20rpx) rotate(8deg); }
}

.how-title { font-weight: 700; margin-bottom: 14rpx; }
.how-item { font-size: 26rpx; line-height: 2; color: #4a4658; }
.how-tip { margin-top: 16rpx; font-size: 22rpx; color: var(--ink2); }

.recent-card { padding: 8rpx 30rpx; }
.recent-item {
  display: flex; align-items: center; justify-content: space-between;
  padding: 22rpx 0; border-bottom: 1rpx solid #f1edf9;
}
.recent-item:last-child { border-bottom: none; }
.recent-title { font-size: 27rpx; }
.recent-time { color: var(--ink2); font-size: 22rpx; margin-top: 4rpx; }
.recent-score {
  font-weight: 800; font-size: 34rpx;
  background: var(--grad);
  -webkit-background-clip: text; background-clip: text; color: transparent;
}

.foot { text-align: center; color: #b9b3c9; font-size: 22rpx; margin-top: 56rpx; }
