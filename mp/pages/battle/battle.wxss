.page { padding: 24rpx 32rpx 60rpx; }

/* 答题 */
.battle-head { margin-top: 30rpx; text-align: center; }
.battle-from { font-size: 28rpx; color: var(--ink2); }
.battle-from b { color: #e0337c; }
.battle-progress { margin-top: 12rpx; font-size: 24rpx; color: #b9b3c9; }
.battle-progress b { font-size: 30rpx; color: var(--ink); }

.progress-track { height: 10rpx; background: #e9e3f7; border-radius: 99rpx; margin: 26rpx 6rpx 6rpx; overflow: hidden; }
.progress-bar { height: 100%; width: 0; background: var(--grad); border-radius: 99rpx; transition: width 0.3s; }

.q-card { padding: 40rpx 32rpx; }
.q-text { font-size: 36rpx; line-height: 1.55; text-align: center; margin: 16rpx 8rpx 30rpx; font-weight: 600; }
.q-opt {
  border: 3rpx solid #eee9f8; background: #faf8ff; border-radius: 24rpx;
  padding: 14rpx 0; font-size: 28rpx; text-align: center; color: #4a4658;
  margin-bottom: 18rpx; font-weight: 400;
}
.q-opt::after { border: none; }
.q-opt:last-child { margin-bottom: 0; }

/* 战报 */
.score-hero { margin-top: 46rpx; text-align: center; }
.score-row { display: flex; align-items: baseline; justify-content: center; }
.score-num {
  font-size: 110rpx; font-weight: 800; line-height: 1;
  background: var(--grad); -webkit-background-clip: text; background-clip: text; color: transparent;
}
.score-pct { font-size: 44rpx; color: #c9a0e8; margin-left: 6rpx; }
.verdict-emoji { font-size: 72rpx; margin-top: 10rpx; }
.verdict-title { font-size: 44rpx; font-weight: 800; margin-top: 8rpx; letter-spacing: 4rpx; }
.verdict-sub { margin-top: 14rpx; font-size: 24rpx; color: var(--ink2); line-height: 1.7; padding: 0 20rpx; }

.detail-item { padding: 26rpx 30rpx; }
.d-q { display: flex; gap: 14rpx; align-items: flex-start; }
.d-badge {
  flex-shrink: 0; width: 38rpx; height: 38rpx; border-radius: 50%;
  font-size: 22rpx; display: flex; align-items: center; justify-content: center;
  color: #fff; font-weight: 700; margin-top: 2rpx;
}
.d-badge.hit { background: var(--ok); }
.d-badge.miss { background: #d9d2ea; }
.d-text { font-size: 27rpx; font-weight: 600; line-height: 1.5; flex: 1; }

.d-answers { display: flex; flex-wrap: wrap; gap: 14rpx; margin-top: 18rpx; }
.d-ans {
  width: calc(50% - 7rpx); border-radius: 18rpx; padding: 14rpx 18rpx;
  font-size: 24rpx; line-height: 1.5; box-sizing: border-box;
}
.d-who { font-size: 20rpx; opacity: 0.75; margin-bottom: 4rpx; }
.d-ans.hit { background: #f0fdf4; border: 2rpx solid #bbf7d0; color: #15803d; }
.d-ans.miss { background: #faf8ff; border: 2rpx solid #e9e3f7; color: #6b6680; }

.result-actions { margin-top: 48rpx; display: flex; flex-direction: column; gap: 18rpx; }
.act-btn { font-size: 30rpx; padding: 8rpx 0; width: 100%; }
.act-btn::after { border: none; }

/* 错误 */
.err-box { text-align: center; margin-top: 180rpx; }
.err-emoji { font-size: 100rpx; }
.err-title { font-size: 32rpx; font-weight: 700; margin-top: 24rpx; }
.err-tip { font-size: 25rpx; color: var(--ink2); margin-top: 12rpx; }
.err-btn { margin-top: 48rpx; font-size: 28rpx; width: 60%; padding: 8rpx 0; color: #fff; }
