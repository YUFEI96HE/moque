<view class="page">
  <view class="card name-card">
    <view class="lbl">你的称呼（会出现在挑战卡上）</view>
    <input class="input" maxlength="12" placeholder="比如：最懂TA的人" bindinput="inputName" value="{{name}}" />
  </view>

  <scroll-view scroll-x class="cat-scroll" enhanced show-scrollbar="{{false}}">
    <view class="cat-tabs">
      <view
        wx:for="{{cats}}"
        wx:key="id"
        class="cat-tab {{cat === item.id ? 'on' : ''}}"
        bindtap="setCat"
        data-cat="{{item.id}}"
      >{{item.emoji}} {{item.name}}</view>
    </view>
  </scroll-view>

  <!-- 自定义题 -->
  <view
    wx:for="{{customList}}"
    wx:key="cid"
    class="card q-card-item {{item.picked ? 'picked' : ''}}"
    bindtap="toggleCustom"
    data-cid="{{item.cid}}"
  >
    <view class="q-head">
      <view class="q-pick"></view>
      <view class="q-main">
        <view class="q-title">✍️ {{item.t}}</view>
        <view class="q-tag">自定义题 · {{item.picked ? '点下方选择你的答案' : '点击卡片选中'}}</view>
      </view>
    </view>
    <view class="ans-opts" wx:if="{{item.picked}}">
      <view
        wx:for="{{item.opts}}"
        wx:for-item="opt"
        wx:for-index="oi"
        wx:key="oi"
        class="ans-opt {{opt.on ? 'on' : ''}}"
        catchtap="setCustomAns"
        data-cid="{{item.cid}}"
        data-i="{{oi}}"
      >{{opt.t}}</view>
    </view>
  </view>

  <!-- 题库题 -->
  <view
    wx:for="{{qList}}"
    wx:key="id"
    class="card q-card-item {{item.picked ? 'picked' : ''}}"
    bindtap="toggleQ"
    data-id="{{item.id}}"
  >
    <view class="q-head">
      <view class="q-pick"></view>
      <view class="q-main">
        <view class="q-title">{{item.text}}</view>
        <view class="q-tag">{{item.tag}} · {{item.picked ? '点下方选择你的答案' : '点击卡片选中'}}</view>
      </view>
    </view>
    <view class="ans-opts" wx:if="{{item.picked}}">
      <view
        wx:for="{{item.opts}}"
        wx:for-item="opt"
        wx:for-index="oi"
        wx:key="oi"
        class="ans-opt {{opt.on ? 'on' : ''}}"
        catchtap="setAns"
        data-id="{{item.id}}"
        data-i="{{oi}}"
      >{{opt.t}}</view>
    </view>
  </view>

  <!-- 自定义出题表单 -->
  <view class="card custom-card">
    <view class="custom-title">✍️ 自定义题（可选）</view>
    <input class="input" maxlength="40" placeholder="写一个只有你们懂的问题" bindinput="inputCustomQ" value="{{customT}}" />
    <view class="custom-opts">
      <input class="input" maxlength="12" placeholder="选项A" bindinput="inputCustomO" data-i="0" value="{{customO[0]}}" />
      <input class="input" maxlength="12" placeholder="选项B" bindinput="inputCustomO" data-i="1" value="{{customO[1]}}" />
      <input class="input" maxlength="12" placeholder="选项C" bindinput="inputCustomO" data-i="2" value="{{customO[2]}}" />
      <input class="input" maxlength="12" placeholder="选项D" bindinput="inputCustomO" data-i="3" value="{{customO[3]}}" />
    </view>
    <button class="btn-ghost custom-add" bindtap="addCustom">＋ 加入候选</button>
  </view>

  <view class="bottom-space"></view>

  <!-- 底部操作栏 -->
  <view class="sticky-bar">
    <view class="picked-count">已选 <b>{{pickedCount}}</b>/5</view>
    <button class="btn-primary bar-btn" disabled="{{pickedCount === 0}}" bindtap="make">生成挑战</button>
  </view>

  <!-- 生成成功面板 -->
  <view class="mask" wx:if="{{generated}}" catchtap="backEdit">
    <view class="gen-card card" catchtap="">
      <view class="gen-emoji">🎉</view>
      <view class="gen-title">挑战已生成！</view>
      <view class="gen-sub">把它发给那个「TA」，TA 答完立刻出结果，记得让 TA 把战报分享回来～</view>
      <button class="btn-primary gen-share" open-type="share">📤 发给 TA</button>
      <view class="gen-back" bindtap="backEdit">← 重新编辑题目</view>
    </view>
  </view>
</view>
