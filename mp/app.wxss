/* 心有灵犀 —— 全局样式（rpx） */
page {
  --grad: linear-gradient(135deg, #ff6b9d 0%, #b34fd1 100%);
  --bg: #f6f4ff;
  --ink: #2d2a3a;
  --ink2: #8a8699;
  --ok: #22c55e;
  --bad: #f43f5e;
  background: var(--bg);
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  color: var(--ink);
  font-size: 28rpx;
}

.card {
  background: #fff;
  border-radius: 32rpx;
  padding: 30rpx;
  box-shadow: 0 10rpx 40rpx rgba(120, 80, 180, 0.10);
  margin-top: 24rpx;
}

.btn-primary {
  background: var(--grad);
  color: #fff;
  border-radius: 999rpx;
  font-weight: 600;
  box-shadow: 0 10rpx 30rpx rgba(255, 107, 157, 0.35);
}
.btn-primary::after { border: none; }
.btn-primary[disabled] { opacity: 0.45; }

.btn-ghost {
  background: rgba(179, 79, 209, 0.08);
  color: #a04ecb;
  border-radius: 999rpx;
  font-weight: 600;
}
.btn-ghost::after { border: none; }

.input {
  display: block;
  width: 100%;
  height: 84rpx;
  min-height: 84rpx;
  padding: 0 26rpx;
  border: 2rpx solid #eee9f8;
  border-radius: 20rpx;
  font-size: 28rpx;
  background: #faf8ff;
  box-sizing: border-box;
  color: var(--ink);
}

.sec-title {
  margin: 40rpx 4rpx 20rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.toast-tip {
  position: fixed;
  left: 50%;
  bottom: 160rpx;
  transform: translateX(-50%);
  background: rgba(40, 30, 60, 0.88);
  color: #fff;
  font-size: 26rpx;
  padding: 18rpx 34rpx;
  border-radius: 999rpx;
  z-index: 99;
  white-space: nowrap;
  max-width: 90vw;
  overflow: hidden;
  text-overflow: ellipsis;
}
